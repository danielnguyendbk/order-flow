{
  "name": "order-flow-backend",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "dev:bot": "tsx apps/telegram-bot/src/index.ts",
    "dev:notification-worker": "tsx apps/telegram-bot/src/worker.ts",
    "build:bot": "tsc --project apps/telegram-bot/tsconfig.json",
    "check:bot": "tsc --noEmit --project apps/telegram-bot/tsconfig.json",
    "test:bot": "vitest run --config apps/telegram-bot/vitest.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
