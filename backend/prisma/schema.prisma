generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────────────

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  UNDERPAID
  OVERPAID
  REVIEW
}

enum FulfillmentStatus {
  PENDING_PAYMENT
  QUEUED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  QR
  CASH
}

enum UserRole {
  OWNER
  SERVICE_STAFF
  BARISTA

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

// ── Models ─────────────────────────────────────────────────────

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName       String     @map("full_name") @db.VarChar(150)
  telegramUserId BigInt?    @unique @map("telegram_user_id")
  telegramChatId BigInt?    @map("telegram_chat_id")
  username       String?    @unique @db.VarChar(100)
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  role           UserRole
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Order {
  id                 String            @id @default(uuid())
  orderCode          String            @unique
  createdByUserId    String
  assignedBaristaId  String?
  paymentMethod      PaymentMethod?
  paymentStatus      PaymentStatus     @default(UNPAID)
  fulfillmentStatus  FulfillmentStatus @default(PENDING_PAYMENT)
  totalAmount        BigInt            @default(0)
  customerNote       String?
  cancellationReason String?
  paidAt             DateTime?
  items              OrderItem[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  itemName   String
  unitPrice  BigInt
  quantity   Int
  note       String?
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
