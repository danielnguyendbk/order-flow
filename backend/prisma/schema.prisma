generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  SERVICE_STAFF
  BARISTA

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum PaymentMethod {
  QR
  CASH

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  UNDERPAID
  OVERPAID
  REVIEW

  @@map("payment_status")
}

enum FulfillmentStatus {
  PENDING_PAYMENT
  QUEUED
  PREPARING
  READY
  DELIVERED
  CANCELLED

  @@map("fulfillment_status")
}

enum OrderStatusDomain {
  PAYMENT
  FULFILLMENT

  @@map("order_status_domain")
}

model User {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName              String               @map("full_name") @db.VarChar(150)
  telegramUserId        BigInt?              @unique @map("telegram_user_id")
  telegramChatId        BigInt?              @map("telegram_chat_id")
  username              String?              @unique @db.VarChar(100)
  passwordHash          String?              @map("password_hash")
  role                  UserRole
  status                UserStatus           @default(ACTIVE)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdOrders         Order[]              @relation("OrderCreator")
  assignedOrders        Order[]              @relation("OrderBarista")
  confirmedPayments     Payment[]            @relation("CashConfirmer")
  orderStatusChanges    OrderStatusHistory[] @relation("HistoryActor")

  @@map("users")
}

model MenuCategory {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @unique @db.VarChar(100)
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  items        MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  name         String       @db.VarChar(150)
  description  String?
  price        BigInt
  isAvailable  Boolean      @default(true) @map("is_available")
  imageUrl     String?      @map("image_url")
  displayOrder Int          @default(0) @map("display_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  category     MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]

  @@index([categoryId, displayOrder], map: "menu_items_category_display_idx")
  @@map("menu_items")
}

model Order {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode          String               @unique @map("order_code") @db.VarChar(32)
  createdByUserId    String               @map("created_by_user_id") @db.Uuid
  assignedBaristaId  String?              @map("assigned_barista_id") @db.Uuid
  paymentMethod      PaymentMethod?       @map("payment_method")
  paymentStatus      PaymentStatus        @default(UNPAID) @map("payment_status")
  fulfillmentStatus  FulfillmentStatus    @default(PENDING_PAYMENT) @map("fulfillment_status")
  totalAmount        BigInt               @default(0) @map("total_amount")
  customerNote       String?              @map("customer_note")
  cancellationReason String?              @map("cancellation_reason")
  paidAt             DateTime?            @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator            User                 @relation("OrderCreator", fields: [createdByUserId], references: [id])
  assignedBarista    User?                @relation("OrderBarista", fields: [assignedBaristaId], references: [id])
  items              OrderItem[]
  payment            Payment?
  history            OrderStatusHistory[]

  @@index([createdByUserId, createdAt(sort: Desc)], map: "orders_creator_created_at_idx")
  @@index([fulfillmentStatus, createdAt(sort: Desc)], map: "orders_fulfillment_created_at_idx")
  @@index([paymentStatus, createdAt(sort: Desc)], map: "orders_payment_created_at_idx")
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  itemName   String   @map("item_name") @db.VarChar(150)
  unitPrice  BigInt   @map("unit_price")
  quantity   Int      @default(1)
  note       String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId, menuItemId], map: "order_items_order_menu_idx")
  @@index([menuItemId], map: "order_items_menu_item_idx")
  @@map("order_items")
}

model Payment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String    @unique @map("order_id") @db.Uuid
  paymentCode           String?   @unique @map("payment_code") @db.VarChar(40)
  expectedAmount        BigInt    @map("expected_amount")
  receivedAmount        BigInt    @default(0) @map("received_amount")
  cashConfirmedByUserId String?   @map("cash_confirmed_by_user_id") @db.Uuid
  confirmedAt           DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashConfirmer         User?     @relation("CashConfirmer", fields: [cashConfirmedByUserId], references: [id])

  @@index([cashConfirmedByUserId], map: "payments_cash_confirmer_idx")
  @@map("payments")
}

model OrderStatusHistory {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  statusDomain    OrderStatusDomain @map("status_domain")
  oldStatus       String?           @map("old_status") @db.VarChar(30)
  newStatus       String            @map("new_status") @db.VarChar(30)
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?             @relation("HistoryActor", fields: [changedByUserId], references: [id])

  @@index([orderId, createdAt(sort: Desc)], map: "order_status_history_order_created_idx")
  @@index([changedByUserId], map: "order_status_history_changed_by_idx")
  @@map("order_status_history")
}
