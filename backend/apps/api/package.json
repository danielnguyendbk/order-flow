{
  "name": "@order-flow/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=../../../.env.local src/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "check:auth": "tsc -p tsconfig.auth.json",
    "start": "node dist/index.js",
    "test:auth": "vitest run --config vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:auth:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "http-errors": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "jest": "^30.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.0.5"
  }
}
