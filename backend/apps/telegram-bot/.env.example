TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://localhost:3001/api/v1
# Must exactly match BOT_INTERNAL_SECRET in the repository .env.local used by the API.
BOT_INTERNAL_SECRET=
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://order_flow:order_flow@localhost:5432/order_flow

# Leave empty in local development to use long polling.
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=
PORT=3001
