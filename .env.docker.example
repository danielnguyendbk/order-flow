# Published images. Change this only when publishing under another registry namespace.
ORDER_FLOW_IMAGE_PREFIX=ghcr.io/danielnguyendbk/order-flow
# Use a release tag that is never changed after deployment, for example v1.2.3.
ORDER_FLOW_VERSION=replace-with-immutable-release-tag

WEB_PORT=3000
API_PORT=3001
BOT_WEBHOOK_PORT=3002

# Use URL-safe characters because Compose inserts this value into DATABASE_URL.
POSTGRES_DB=order_flow
POSTGRES_USER=order_flow
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
BOT_INTERNAL_SECRET=replace-with-a-long-random-shared-secret

SEED_OWNER_FULL_NAME=Store Owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=replace-with-a-strong-owner-password
SEED_PASSWORD_ROUNDS=12

TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=300

SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_HOLDER=
SEPAY_QR_IMAGE_BASE_URL=https://vietqr.app/img
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2/transactions
SEPAY_QR_POLL_ENABLED=false
SEPAY_QR_POLL_INTERVAL_MS=3000
SEPAY_QR_POLL_BATCH_SIZE=5

# Keep false unless the API is reachable only through a trusted reverse proxy.
TRUST_PROXY=false
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# Leave empty to use Telegram long polling. Webhook mode also requires routing
# this HTTPS origin to port 3002 of the telegram-bot service.
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=
