# Supabase Data API (safe to expose to browser code; Row Level Security must be enabled).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Prisma/PostgreSQL (server-only; never prefix these with NEXT_PUBLIC_).
# Use Supavisor transaction mode (port 6543) for serverless application traffic.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"

# Use the direct endpoint, or Supavisor session mode on port 5432 when IPv4 is required,
# for Prisma migrations and other long-lived database operations.
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Shared only by the API and Telegram Bot. Generate a long random value; never expose it to clients.
BOT_INTERNAL_SECRET="replace-with-a-long-random-secret"

# SePay/VietQR payment details (server-only). QR images are generated from these values.
SEPAY_BANK_ACCOUNT="your-bank-account-number"
SEPAY_BANK_NAME="your-bank-short-name"
SEPAY_ACCOUNT_HOLDER="your-account-holder-name"
SEPAY_QR_IMAGE_BASE_URL="https://vietqr.app/img"

# API authentication (server-only). Generate independent random values of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-random-secret-at-least-32-characters"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_CACHE_MAX=10000

# Initial OWNER account created by `cd backend && npm run db:seed`.
# Set the password locally; the seed command refuses an empty/placeholder value.
SEED_OWNER_FULL_NAME="Store Owner"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD=""
SEED_PASSWORD_ROUNDS=12

# Telegram Web App initData verification. Leave empty while Telegram is disabled.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_AUTH_MAX_AGE_SECONDS=300

# API server.
HOST="0.0.0.0"
PORT=3001
